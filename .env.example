# ==============================================================================
# MinIO Local S3-Compatible Storage Configuration
# ==============================================================================
# In production, replace with secure credentials from your secrets manager.
# Never commit real credentials to version control.

# MinIO Root Credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123

# Primary S3 Endpoint (used by Rclone & Applications)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_CONSOLE_PORT=9001
MINIO_REGION=us-east-1

# Rclone S3 Configuration (Used for config-free execution)
RCLONE_S3_PROVIDER=Minio
RCLONE_S3_ACCESS_KEY_ID=admin
RCLONE_S3_SECRET_ACCESS_KEY=admin123
RCLONE_S3_ENDPOINT=http://127.0.0.1:9000
RCLONE_S3_REGION=us-east-1

# Optional Secondary MinIO Endpoint (for bonus cross-endpoint transfers)
MINIO_SECONDARY_ENDPOINT=http://127.0.0.1:9100
MINIO_SECONDARY_PORT=9100
MINIO_SECONDARY_CONSOLE_PORT=9101
